# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Each role tries a list of models and uses the first one the account can serve
# (see app/llm.py). Set one of these to pin a single model instead.
# GROQ_AGENT_MODEL=openai/gpt-oss-120b
# GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
# GROQ_ROUTER_MODEL=openai/gpt-oss-20b

# Optional: SQLite location (defaults to ./doc2agent.db)
# DOC2AGENT_DB=doc2agent.db
