# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional model overrides (all default to llama-3.3-70b-versatile)
# GROQ_AGENT_MODEL=llama-3.3-70b-versatile
# GROQ_EXTRACTION_MODEL=llama-3.3-70b-versatile
# GROQ_ROUTER_MODEL=llama-3.3-70b-versatile

# Optional: SQLite location (defaults to ./doc2agent.db)
# DOC2AGENT_DB=doc2agent.db
